{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "spiceoptimisermcp",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "spiceoptimisermcp"
  },
  "runtimes": [],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "spice-optimiser-gateway",
      "description": "Gateway for Amazon Q chat agent to access SPICE optimisation tools via Lambda",
      "protocolType": "MCP",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_EXAMPLE/.well-known/openid-configuration",
          "allowedClients": [],
          "allowedScopes": [
            "spice-optimiser-gateway/tools.read",
            "spice-optimiser-gateway/tools.write"
          ]
        }
      },
      "targets": [
        {
          "name": "spice-optimiser-lambda",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:123456789012:function:spice-optimiser-function",
            "toolSchemaFile": "tool-schema.json"
          }
        }
      ]
    }
  ],
  "unassignedTargets": [
    {
      "name": "spice-optimiser-lambda",
      "targetType": "lambdaFunctionArn",
      "lambdaFunctionArn": {
        "lambdaArn": "arn:aws:lambda:us-east-1:123456789012:function:spice-optimiser-function",
        "toolSchemaFile": "tool-schema.json"
      }
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
